<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    i18n_domain="udala.zinegotziak"
    >

  <configure zcml:condition="installed AccessControl.security">
    <!-- -*- extra stuff goes here -*- -->
    <permission
        id="udala.zinegotziak.AddCouncillor"
        title="udala.zinegotziak: Add Councillor"
        />


    <permission
        id="udala.zinegotziak.AddCommission"
        title="udala.zinegotziak: Add Commission"
        />


    <permission
        id="udala.zinegotziak.AddParty"
        title="udala.zinegotziak: Add Party"
        />
  </configure>
</configure>
