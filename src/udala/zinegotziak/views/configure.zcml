<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="udala.zinegotziak"
    >

  <!-- -*- extra stuff goes here -*- -->



  <browser:page
      name="zinegotziak-view"
      for="plone.app.contenttypes.interfaces.IFolder"
      class=".zinegotziak_view.ZinegotziakView"
      template="zinegotziak_view.pt"
      permission="zope2.View"
      layer="udala.zinegotziak.interfaces.IBrowserLayer"
      />

  <browser:page
      name="view"
      for="udala.zinegotziak.content.alderdia.IAlderdia"
      class=".alderdia_view.AlderdiaView"
      template="alderdia_view.pt"
      permission="zope2.View"
      layer="udala.zinegotziak.interfaces.IBrowserLayer"
      />

  <browser:page
      name="view"
      for="udala.zinegotziak.content.batzordea.IBatzordea"
      class=".batzordea_view.BatzordeaView"
      template="batzordea_view.pt"
      permission="zope2.View"
      layer="udala.zinegotziak.interfaces.IBrowserLayer"
      />

  <browser:page
      name="view"
      for="udala.zinegotziak.content.zinegotzia.IZinegotzia"
      class=".zinegotzia_view.ZinegotziaView"
      template="zinegotzia_view.pt"
      permission="zope2.View"
      layer="udala.zinegotziak.interfaces.IBrowserLayer"
      />



</configure>
