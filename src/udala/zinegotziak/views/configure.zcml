<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="udala.zinegotziak"
    >

  <!-- -*- extra stuff goes here -*- -->

  <include package="plone.app.contentmenu" />

  <browser:page
      name="zinegotziak-view"
      for="plone.app.contenttypes.interfaces.IFolder"
      class=".councillors_view.CouncillorsView"
      template="councillors_view.pt"
      permission="zope2.View"
      layer="udala.zinegotziak.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="Councillor listing"
      />

  <browser:page
      name="view"
      for="udala.zinegotziak.content.party.IParty"
      class=".party_view.PartyView"
      template="party_view.pt"
      permission="zope2.View"
      layer="udala.zinegotziak.interfaces.IBrowserLayer"
      />

  <browser:page
      name="view"
      for="udala.zinegotziak.content.commission.ICommission"
      class=".commission_view.CommissionView"
      template="commission_view.pt"
      permission="zope2.View"
      layer="udala.zinegotziak.interfaces.IBrowserLayer"
      />

  <browser:page
      name="view"
      for="udala.zinegotziak.content.councillor.ICouncillor"
      class=".councillor_view.CouncillorView"
      template="councillor_view.pt"
      permission="zope2.View"
      layer="udala.zinegotziak.interfaces.IBrowserLayer"
      />



</configure>
