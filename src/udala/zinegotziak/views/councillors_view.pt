<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="udala.zinegotziak"
>

  <body>

    <metal:content-core fill-slot="content-core">
      <metal:block define-macro="content-core">

        <tal:define tal:define="
                      parties view/parties;
                    "
                    tal:condition="parties"
        >

          <div class="party-content card shadow-sm border-0 mb-5 overflow-hidden"
               tal:repeat="party parties"
          >
            <div class="card-header bg-light border-bottom p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
              <h2 class="mb-0">
                <a class="text-primary text-decoration-none"
                   tal:content="party/title"
                   tal:attributes="
                     href party/absolute_url;
                   "
                ></a>
              </h2>

              <div class="bg-white p-2 rounded shadow-sm flex-shrink-0 col-3 col-md-2 col-lg-1">
                <img class="img-fluid object-fit-contain"
                     tal:define="
                       scale nocall:party/@@images;
                     "
                     tal:replace="structure python:scale.srcset(
                      fieldname='image',
                      sizes='(max-width: 500px) 100px, 150px',
                      css_class='img-fluid object-fit-contain',
                      alt=party.title,
                      scale_in_src='thumb',
                      title=party.title)"
                />
              </div>
            </div>

            <div class="card-body p-4 bg-white">
              <h3 class="text-secondary mb-4 pb-2 border-bottom"
                  i18n:translate=""
              >Councillors</h3>

              <div class="row g-4"
                   tal:define="
                     councillors party/get_councillors;
                   "
                   tal:condition="councillors"
              >

                <div class="col-sm-6 col-md-4 col-lg-3"
                     tal:repeat="councillor councillors"
                >
                  <div class="text-center h-100 position-relative p-3 rounded">
                    <a class="d-block text-decoration-none"
                       tal:attributes="
                         href councillor/absolute_url;
                       "
                    >
                      <div class="ratio ratio-1x1 rounded-circle overflow-hidden w-75 mx-auto shadow-sm mb-3">
                        <img class="object-fit-cover w-100 h-100"
                             sizes="(min-width: 1200px) 400px,(min-width: 992px) 400px,100vw"
                             tal:define="
                               scale nocall:councillor/@@images;
                             "
                             tal:condition="nocall:councillor/image"
                             tal:replace="structure python:scale.srcset(
                            fieldname='image',
                            sizes='(min-width: 1200px) 400px,(min-width: 992px) 400px,100vw',
                            css_class='object-fit-cover w-100 h-100',
                            alt=councillor.Title(),
                            title=councillor.Title()
                           )"
                        />
                      </div>

                      <h4 class="h6 mb-0 text-dark fw-bold stretched-link"
                          tal:content="councillor/title"
                      ></h4>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </tal:define>

      </metal:block>
    </metal:content-core>
  </body>

</html>
