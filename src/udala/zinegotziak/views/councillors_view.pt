<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="udala.zinegotziak"
>

  <body>

    <metal:content-core fill-slot="content-core">
      <metal:block define-macro="content-core">

        <tal:define tal:define="
                      parties view/parties;
                    "
                    tal:condition="parties"
        >

          <div class="party-content mb-5"
               tal:repeat="party parties"
          >
            <div class="party d-flex align-items-center mb-5">


              <img class="border border-6"
                   sizes="(min-width: 350px) 200px,100vw"
                   tal:define="
                     scale nocall:party/@@images;
                   "
                   tal:replace="structure python:scale.srcset(
                    fieldname='image',
                    sizes='(min-width: 350px) 200px,100vw',
                    alt=party.Title(),
                    title=party.Title()
                   )"
              />

              <h2 class="mx-2">
                <a tal:content="party/title"
                   tal:attributes="
                     href party/absolute_url;
                   "
                ></a>
              </h2>
            </div>
            <h3 i18n:translate="">Councillors</h3>
            <div class="row"
                 tal:define="
                   councillors party/get_councillors;
                 "
                 tal:condition="councillors"
            >

              <div class="col-md-3 col-xs-6"
                   tal:repeat="councillor councillors"
              >

                <img class="border border-6 imagesicer mb-3"
                     sizes="(min-width: 1200px) 400px,(min-width: 992px) 400px,100vw"
                     tal:define="
                       scale nocall:councillor/@@images;
                     "
                     tal:condition="nocall:councillor/image"
                     tal:replace="structure python:scale.srcset(
                    fieldname='image',
                    sizes='(min-width: 1200px) 400px,(min-width: 992px) 400px,100vw',
                    css_class='border border-6 imagesicer mb-3',
                    alt=councillor.Title(),
                    title=councillor.Title()
                   )"
                />

                <h4>
                  <a tal:content="councillor/title"
                     tal:attributes="
                       href councillor/absolute_url;
                     "
                  ></a>
                </h4>
              </div>
            </div>
          </div>
        </tal:define>


      </metal:block>
    </metal:content-core>
  </body>

</html>
