<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="udala.zinegotziak"
>

  <body>

    <metal:content-core fill-slot="main">
      <metal:block define-macro="main">

        <main id="replace-content">
          <div class="row">
            <div class="col-sm-4 order-sm-2 d-flex flex-column align-items-end">
              <img class="border border-6 mb-3"
                   sizes="(min-width: 350px) 400px,100vw"
                   tal:define="
                     item context/get_party;
                     scale item/@@images;
                   "
                   tal:condition="nocall:item/image"
                   tal:replace="structure python:scale.srcset(
                      fieldname='image',
                      sizes='(min-width: 350px) 100px,100vw',
                      css_class='border border-6 mb-3',
                      alt=item.Title(),
                      title=item.Title()
                   )"
              />
              <img class="border border-6 mb-3"
                   sizes="(min-width: 350px) 400px,100vw"
                   tal:define="
                     scale nocall:context/@@images;
                   "
                   tal:condition="nocall:context/image"
                   tal:replace="structure python:scale.srcset(
                   fieldname='image',
                   sizes='(min-width: 350px) 400px,100vw',
                   css_class='border border-6 mb-3',
                   alt=context.Title(),
                   title=context.Title()
                   )"
              />


              <div class="col-md-12">

                <ul class="social-network list-inline mt-3"
                    tal:define="
                      sociallinks context/social_links;
                    "
                    tal:condition="sociallinks"
                >
                  <li class="list-inline-item"
                      tal:repeat="sociallink sociallinks"
                  ><a class="rounded-circle bg-gray text-light p-3"
                       title="Facebook"
                       tal:attributes="
                         href sociallink/url;
                         title sociallink/name;
                       "
                    >
                      <tal:icon tal:replace="structure python:icons.tag(sociallink['iconname'])" />
                    </a>
                  </li>
                </ul>
              </div>

            </div>
            <div class="col-md-8 order-sm-1">

              <h1 tal:content="context/Title"></h1>

              <div class="documentDescription description"
                   tal:content="context/Description"
              ></div>

              <div id="parent-fieldname-text"
                   tal:define="
                     toc context/table_of_contents|nothing;
                   "
                   tal:condition="context/text"
                   tal:content="structure python:context.text.output_relative_to(view.context)"
                   tal:attributes="
                     class python: toc and 'pat-autotoc' or '';
                   "
              >
              </div>

              <div id="positions">
                <h3 i18n:translate="">Positions</h3>
                <ul>
                  <li tal:repeat="position view/get_positions">
                    <strong tal:content="python:position[0]">President</strong>:
                    <tal:item repeat="item python:position[1]">
                      <a href=""
                         tal:content="item/commission_title"
                         tal:attributes="
                           href item/commission_url;
                         "
                      >
                      Commission name
                      </a><span tal:condition="not:repeat/item/end">,</span>
                    </tal:item>
                  </li>
                </ul>
              </div>
              <div id="parent-fieldname-text-other_positions"
                   tal:define="
                     toc context/table_of_contents|nothing;
                   "
                   tal:condition="context/other_positions"
                   tal:content="structure python:context.other_positions.output_relative_to(view.context)"
                   tal:attributes="
                     class python: toc and 'pat-autotoc' or '';
                   "
              >
              </div>

            </div>
          </div>
          <div class="accordion"
               id="councillor-accordion"
          >
            <div class="accordion-item">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed"
                        aria-controls="collapseOne"
                        type="button"
                        data-bs-target="#collapseOne"
                        data-bs-toggle="collapse"
                        i18n:translate=""
                >
                CV
                </button>
              </h2>
              <div class="accordion-collapse collapse"
                   id="collapseOne"
                   data-bs-parent="#councillor-accordion"
              >
                <div class="accordion-body">
                  <p tal:condition="python: not context.cv_text and not context.cv_file"
                     i18n:translate=""
                  >
                    There is no related information
                  </p>
                  <div id="parent-fieldname-text-cv_text"
                       tal:define="
                         toc context/table_of_contents|nothing;
                       "
                       tal:condition="context/cv_text"
                       tal:content="structure python:context.cv_text.output_relative_to(view.context)"
                       tal:attributes="
                         class python: toc and 'pat-autotoc' or '';
                       "
                  >
                  </div>
                  <div class="file"
                       tal:condition="nocall:context/cv_file"
                  >
                    <a class="btn btn-primary"
                       tal:attributes="
                         href string:${context/absolute_url}/@@download/cv_file;
                       "
                       i18n:translate=""
                    >Download file</a>
                  </div>
                </div>
              </div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed"
                        aria-controls="collapseTwo"
                        type="button"
                        data-bs-target="#collapseTwo"
                        data-bs-toggle="collapse"
                        i18n:translate=""
                >
                Earnings
                </button>
              </h2>
              <div class="accordion-collapse collapse"
                   id="collapseTwo"
                   data-bs-parent="#councillor-accordion"
              >
                <div class="accordion-body">
                  <p tal:condition="python: not context.earnings_text and not context.earnings_file"
                     i18n:translate=""
                  >
                    There is no related information
                  </p>
                  <div id="parent-fieldname-text-earnings"
                       tal:define="
                         toc context/table_of_contents|nothing;
                       "
                       tal:condition="context/earnings_text"
                       tal:content="structure python:context.earnings_text.output_relative_to(view.context)"
                       tal:attributes="
                         class python: toc and 'pat-autotoc' or '';
                       "
                  >
                  </div>
                  <div class="file"
                       tal:condition="nocall:context/earnings_file"
                  >
                    <a class="btn btn-primary"
                       tal:attributes="
                         href string:${context/absolute_url}/@@download/earnings_file;
                       "
                       i18n:translate=""
                    >Download file</a>
                  </div>
                </div>
              </div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed"
                        aria-controls="collapseThree"
                        type="button"
                        data-bs-target="#collapseThree"
                        data-bs-toggle="collapse"
                        i18n:translate=""
                >
                Assets declaration
                </button>
              </h2>
              <div class="accordion-collapse collapse"
                   id="collapseThree"
                   data-bs-parent="#councillor-accordion"
              >
                <div class="accordion-body">
                  <p tal:condition="python: not context.assets_declaration_text and not context.assets_declaration_file"
                     i18n:translate=""
                  >
                    There is no related information
                  </p>
                  <div id="parent-fieldname-text-assets_declaration_text"
                       tal:define="
                         toc context/table_of_contents|nothing;
                       "
                       tal:condition="context/assets_declaration_text"
                       tal:content="structure python:context.assets_declaration_text.output_relative_to(view.context)"
                       tal:attributes="
                         class python: toc and 'pat-autotoc' or '';
                       "
                  >
                  </div>
                  <div class="file"
                       tal:condition="nocall:context/assets_declaration_file"
                  >
                    <a class="btn btn-primary"
                       tal:attributes="
                         href string:${context/absolute_url}/@@download/assets_declaration_file;
                       "
                       i18n:translate=""
                    >Download file</a>
                  </div>
                </div>
              </div>
            </div>
            <div class="accordion-item">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed"
                        aria-controls="collapseFour"
                        type="button"
                        data-bs-target="#collapseFour"
                        data-bs-toggle="collapse"
                        i18n:translate=""
                >
                Activities declaration
                </button>
              </h2>
              <div class="accordion-collapse collapse"
                   id="collapseFour"
                   data-bs-parent="#councillor-accordion"
              >
                <div class="accordion-body">
                  <p tal:condition="python: not context.activities_declaration_text and not context.activities_declaration_file"
                     i18n:translate=""
                  >
                    There is no related information
                  </p>
                  <div id="parent-fieldname-text-activities_declaration_text"
                       tal:define="
                         toc context/table_of_contents|nothing;
                       "
                       tal:condition="context/activities_declaration_text"
                       tal:content="structure python:context.activities_declaration_text.output_relative_to(view.context)"
                       tal:attributes="
                         class python: toc and 'pat-autotoc' or '';
                       "
                  >
                  </div>
                  <div class="fitxategia"
                       tal:condition="nocall:context/activities_declaration_file"
                  >
                    <a class="btn btn-primary"
                       tal:attributes="
                         href string:${context/absolute_url}/@@download/activities_declaration_file;
                       "
                       i18n:translate=""
                    >Download file</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </main>
      </metal:block>
    </metal:content-core>
  </body>

</html>
