<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="udala.zinegotziak"
>

  <body>

    <metal:content-core fill-slot="content-core">
      <metal:block define-macro="content-core">

        <div class="lead text-secondary mb-5 pb-4 border-bottom"
             id="parent-fieldname-text-commission"
             tal:define="
               toc context/table_of_contents|nothing;
             "
             tal:condition="context/text"
             tal:content="structure python:context.text.output_relative_to(view.context)"
             tal:attributes="
               class python: toc and 'pat-autotoc lead text-secondary mb-5 pb-4 border-bottom' or 'lead text-secondary mb-5 pb-4 border-bottom';
             "
        >
        </div>

        <div class="card shadow-sm border-0 bg-light p-4">
          <h2 class="mb-4 pb-2 border-bottom"
              i18n:translate=""
          >Commission members</h2>

          <div class="row g-4"
               id="commission-members"
          >
            <tal:item repeat="member view/get_members">
              <div class="col-sm-6 col-md-4 col-lg-3"
                   tal:define="
                     councillor nocall:member/councillor;
                   "
              >
                <div class="card h-100 border-0 shadow-sm text-center bg-white">
                  <a class="d-block pt-4 px-4 text-decoration-none"
                     tal:define="
                       councillor nocall:member/councillor;
                       scale councillor/@@images;
                     "
                     tal:condition="nocall:councillor/image"
                     tal:attributes="
                       href councillor/absolute_url;
                     "
                  >
                    <div class="ratio ratio-1x1 rounded-circle overflow-hidden w-50 mx-auto shadow-sm border border-2 border-primary border-opacity-25">
                      <img class="object-fit-cover w-100 h-100"
                           sizes=""
                           tal:replace="structure python:scale.srcset(
                            fieldname='image',
                            sizes='(min-width: 1200px) 900px,(min-width: 992px) 768px,100vw',
                            css_class='object-fit-cover w-100 h-100',
                            alt=councillor.Title(),
                            title=councillor.Title(),
                          )"
                      />
                    </div>
                  </a>

                  <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                      <h3 class="mb-2">
                        <a class="text-dark text-decoration-none stretched-link"
                           tal:content="councillor/Title"
                           tal:attributes="
                             href councillor/absolute_url;
                           "
                        ></a>
                      </h3>
                      <div class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 mb-2 px-2 py-1 fw-normal shadow-sm">
                        <span tal:content="member/position">Position</span>
                      </div>
                    </div>

                    <div class="mt-2 text-muted small fw-medium">
                      <span tal:content="python:councillor.get_party().Title()">Party</span>
                    </div>
                  </div>
                </div>
              </div>
            </tal:item>
          </div>
        </div>

      </metal:block>
    </metal:content-core>
  </body>

</html>
