<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="udala.zinegotziak"
>

  <body>

    <metal:content-core fill-slot="main">
      <metal:block define-macro="content-core">

        <h1 tal:replace="structure context/@@title"></h1>


        <div class="alderdia d-flex align-items-center justify-content-between mb-4 mb-lg-5"
             tal:define="
               scale_func context/@@images;
             "
        >

          <div id="parent-fieldname-text-batzordea"
               tal:define="
                 toc context/table_of_contents|nothing;
               "
               tal:condition="context/text"
               tal:content="structure python:context.text.output_relative_to(view.context)"
               tal:attributes="
                 class python: toc and 'pat-autotoc' or '';
               "
          >
          </div>


          <h2 class="m-0 ms-3"
              i18n:translate=""
          >Kideak</h2>
          <img class="border border-6"
               tal:replace="structure python:scale_func.srcset(
                fieldname='image',
                sizes='(min-width: 350px) 400px,100vw',
                css_class='border border-6',
                alt=context.title,
                title=context.title)"
          />

        </div>
        <div class="row">
          <div class="col-md-3 col-xs-6"
               tal:repeat="zinegotzia view/zinegotziak"
          >

            <a tal:define="
                 scale nocall:zinegotzia/@@images;
               "
               tal:attributes="
                 href zinegotzia/absolute_url;
               "
            >
              <img class="border border-6 imagesicer mb-3"
                   sizes="(min-width: 1200px) 900px,(min-width: 992px) 768px,100vw"
                   tal:replace="structure python:scale.srcset(
                            fieldname='image',
                            sizes='(min-width: 1200px) 900px,(min-width: 992px) 768px,100vw',
                            css_class='border border-6 imagesicer mb-3',
                            alt=zinegotzia.title,
                            title=zinegotzia.title)"
                   tal:on-error="string:"
              />
            </a>

            <h6>
              <a tal:content="zinegotzia/title"
                 tal:attributes="
                   href zinegotzia/absolute_url;
                 "
              ></a>
            </h6>
          </div>
        </div>

      </metal:block>
    </metal:content-core>
  </body>

</html>
